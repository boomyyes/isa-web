# Copy to .env.local and fill in. Never commit .env.local.
# On your host (Vercel/Cloudflare/Netlify) set these as environment variables too.

# --- Certificate roster: Upstash Redis -------------------------------------
# console.upstash.com > your database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Certificate images: Cloudflare R2 --------------------------------------
# Cloudflare dashboard > R2. Keep the bucket PRIVATE — no public r2.dev access.
# The API token needs "Object Read" on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=isa-certificates

# Signs the short-lived certificate download tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_TOKEN_SECRET=

# --- Emailing access codes: SMTP --------------------------------------------
# Used only by scripts/send-passwords.ts, never by the website itself.
#
# Gmail / Google Workspace: turn on 2-step verification, then create an App
# Password (myaccount.google.com > Security > App passwords) and use that as
# SMTP_PASS — your normal account password will not work.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address students will see, e.g. "ISA RAIT <isa.rait@rait.ac.in>"
MAIL_FROM=

# Public site URL. Used to build the links inside emails (certificates page,
# password-reset links), so it must match where the site actually runs.
SITE_URL=https://isarait.org

# --- Automatic roster sync ---------------------------------------------------
# Shared secret between the website and the Apps Script inside the attendance
# sheet. The script sends it as `Authorization: Bearer <secret>` when posting
# the roster to /api/certificates/sync.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the same value in the Sheet: Extensions > Apps Script > Project Settings
# > Script Properties > SYNC_SECRET.
ROSTER_SYNC_SECRET=

# --- ISAAC magazine cover ----------------------------------------------------
# Drive share link https://drive.google.com/file/d/<FILE_ID>/view — just the ID.
# The file must be shared as "Anyone with the link".
ISAAC_COVER_FILE_ID=
