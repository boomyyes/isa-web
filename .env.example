# Copy to .env.local and fill in. Never commit .env.local.
# On your host (Vercel/Cloudflare/Netlify) set these as environment variables too.

# --- Certificate roster: Upstash Redis -------------------------------------
# console.upstash.com > your database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Certificate images: Cloudflare R2 --------------------------------------
# Cloudflare dashboard > R2. Keep the bucket PRIVATE — no public r2.dev access.
# The API token needs "Object Read" on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=isa-certificates

# Signs the short-lived certificate download tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_TOKEN_SECRET=

# --- Emailing access codes: SMTP --------------------------------------------
# Used only by scripts/send-passwords.ts, never by the website itself.
#
# Gmail / Google Workspace: turn on 2-step verification, then create an App
# Password (myaccount.google.com > Security > App passwords) and use that as
# SMTP_PASS — your normal account password will not work.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address students will see, e.g. "ISA RAIT <isa.rait@rait.ac.in>"
MAIL_FROM=

# Public site URL. Used to build the links inside emails (certificates page,
# password-reset links), so it must match where the site actually runs.
SITE_URL=https://isarait.org

# --- Automatic roster sync ---------------------------------------------------
# Shared secret between the website and the Apps Script inside the attendance
# sheet. The script sends it as `Authorization: Bearer <secret>` when posting
# the roster to /api/certificates/sync.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the same value in the Sheet: Extensions > Apps Script > Project Settings
# > Script Properties > SYNC_SECRET.
ROSTER_SYNC_SECRET=

# --- ISAAC magazine cover ----------------------------------------------------
# Drive share link https://drive.google.com/file/d/<FILE_ID>/view — just the ID.
# The file must be shared as "Anyone with the link".
ISAAC_COVER_FILE_ID=

# --- ISAAC magazine reader (the full issue) ----------------------------------
# The pages the on-site reader flips through. Keep these files UNLISTED and
# shared as "anyone with the link" — the link IS the password, and it never
# leaves the server: the browser only ever sees /api/isaac-page/<n>.
#
# Either paste the file IDs in page order (page 0 is the cover)...
ISAAC_PAGE_FILE_IDS=
# ...or point at a Drive folder and let the server list it by filename.
# Needs a Google Cloud API key with the Drive API enabled.
ISAAC_PAGES_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=
#
# With none of these set the reader falls back to ISAAC_COVER_FILE_ID alone.

# --- ISAAC magazine: the issue itself ----------------------------------------
# The magazine PDF in Drive. Share it as "Anyone with the link" and paste the
# ID from https://drive.google.com/file/d/<FILE_ID>/view — the link IS the
# password, and it never leaves the server: pages are rendered here and the
# browser only ever gets one page image at a time, never the PDF.
ISAAC_MAGAZINE_FILE_ID=

# The PDF's open password, if the file is encrypted. Used only on the server to
# decrypt it for rendering — readers are never asked for it and it never
# reaches the browser. Wrap it in double quotes if it contains # or spaces.
ISAAC_MAGAZINE_PASSWORD=

# --- Artemis: the problem statements -----------------------------------------
# The three statements, as a JSON array on a single line. This is the whole
# reason the embargo holds: the text is NOT in this repository, which is public,
# so there is nothing to read early on GitHub or in git history.
#
# Read only by lib/artemis-trials.ts, which carries `import "server-only"` — any
# client component that imports it fails the build rather than shipping the text
# in a JS bundle. Note the missing NEXT_PUBLIC_ prefix: that prefix would inline
# the value into the client bundle at build time, which is exactly the leak this
# arrangement exists to prevent.
#
# Each entry: { id, numeral, patron, patronDomain, title, background[],
# challenge[], scope[] } — the three array fields are rendered as paragraphs.
# Leave unquoted; the text contains both ' and ", and dotenv reads an unquoted
# value to the end of the line. Malformed JSON fails closed: the page stays
# sealed rather than publishing something half-formed.
#
# Set this in .env.local AND in the production host's environment before the
# release instant in lib/artemis.ts (ARTEMIS_RELEASE_AT).
ARTEMIS_TRIALS=
